{
  "name": "speedrunner",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^24.15.0",
    "npm": "^11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "app": "npm run app -w packages/desktop"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
