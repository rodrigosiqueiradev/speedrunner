{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speedrunner",
  "version": "0.1.0",
  "identifier": "dev.rodrigosiqueira.speedrunner",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../web"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Speedrunner",
        "width": 1200,
        "height": 860,
        "minWidth": 400,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Find where your run loses time",
    "longDescription": "Load your LiveSplit splits to see a realistic target time, which segments to practise first, and how every number is worked out. Your splits never leave your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
