{
  "name": "@speedrunner/core",
  "version": "0.1.0",
  "description": "Parse LiveSplit split files and find where a run loses time.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "speedrunner-analyze": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "analyze": "tsx src/cli.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
